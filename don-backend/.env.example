SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=your_email@gmail.com
SMTP_SECURE=false

FIREBASE_PROJECT_ID=your-firebase-project-id
# Use a service-account JSON file path locally, or workload identity in production.
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json
# Alternatively provide the service-account JSON as a single-line secret:
# FIREBASE_SERVICE_ACCOUNT=

JWT_SECRET=generate-a-random-secret-of-at-least-32-characters
PORT=5000
CORS_ORIGINS=http://localhost:5173

# Only used by scripts/migrate-mysql-to-firestore.cjs; not used by the app.
# SOURCE_DB_HOST=
# SOURCE_DB_PORT=3306
# SOURCE_DB_USER=
# SOURCE_DB_PASSWORD=
# SOURCE_DB_NAME=don
